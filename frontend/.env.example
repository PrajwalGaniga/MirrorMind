# ==============================================================================
# MirrorMind Frontend Environment Template
# ==============================================================================

# Option 1: Localhost Backend
# VITE_API_URL=http://localhost:8000

# Option 2: ngrok Public Tunnel
# VITE_API_URL=https://dawdlingly-pseudoinsane-pa.ngrok-free.dev

# Option 3: Production Render Backend
VITE_API_URL=https://mirrormind-uwiz.onrender.com

# Audio Constraints Configuration (default: true)
VITE_AUDIO_ECHO_CANCELLATION=true
VITE_AUDIO_NOISE_SUPPRESSION=true
VITE_AUDIO_AUTO_GAIN_CONTROL=true

# Client-side Manual VAD Flag (default: false, server automatic activity detection handles turns)
VITE_USE_MANUAL_VAD=false

